{
  "name": "pdf2pngs",
  "author": "",
  "license": "MIT",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.5.0"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pdf2pngs": "dist/index.js"
  },
  "scripts": {
    "start": "node --no-warnings --import tsx src/index.ts",
    "dev": "node --no-warnings --inspect --import tsx src/index.ts",
    "dev:watch": "node --no-warnings --inspect --import tsx --watch src/index.ts",
    "typecheck": "tsc -p tsconfig.prod.json --noEmit",
    "test": "node --no-warnings node_modules/.bin/vitest",
    "test:run": "node --no-warnings node_modules/.bin/vitest run",
    "clean": "rm -rf dist",
    "build": "npm run clean && npm run typecheck && tsc -p tsconfig.prod.json"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  },
  "dependencies": {
    "ink": "^6.5.1",
    "pdf-to-png-converter": "^3.11.0",
    "react": "^19.2.0"
  }
}
