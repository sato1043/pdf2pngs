{
  "name": "testpdfjs",
  "author": "",
  "license": "MIT",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.5.0"
  },
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx --inspect src/index.ts",
    "dev:watch": "tsx --inspect watch src/index.ts",
    "typecheck": "tsc -p tsconfig.prod.json --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "dist:clean": "rm -rf dist",
    "dist:build": "npm run dist:clean && npm run typecheck && tsc -p tsconfig.prod.json",
    "dist:start": "node dist/index.js"
  },
  "devDependencies": {
    "@prisma/client": "^7.0.1",
    "@types/node": "^24.10.1",
    "dotenv": "^17.2.3",
    "prisma": "^7.0.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  }
}
