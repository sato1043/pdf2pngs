{
  "name": "testpdfjs",
  "author": "",
  "license": "MIT",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.5.0"
  },
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "node --no-warnings --import tsx src/index.ts",
    "dev": "node --no-warnings --inspect --import tsx src/index.ts",
    "dev:watch": "node --no-warnings --inspect --import tsx --watch src/index.ts",
    "typecheck": "tsc -p tsconfig.prod.json --noEmit",
    "test": "node --no-warnings node_modules/.bin/vitest",
    "test:run": "node --no-warnings node_modules/.bin/vitest run",
    "dist:clean": "rm -rf dist",
    "dist:build": "npm run dist:clean && npm run typecheck && tsc -p tsconfig.prod.json",
    "dist:start": "node --no-warnings dist/index.js"
  },
  "devDependencies": {
    "@prisma/client": "^7.0.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "dotenv": "^17.2.3",
    "prisma": "^7.0.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  },
  "dependencies": {
    "ink": "^6.5.1",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.0"
  }
}
